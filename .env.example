PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=safetap
DB_PASSWORD=replace-me
DB_NAME=safetap
DB_SSL=0
# Cloud MySQL: DB_SSL=1 and the provider CA certificate file.
# Render secret file path: /etc/secrets/aiven-ca.pem
DB_SSL_CA_FILE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Enable only behind your trusted HTTPS reverse proxy:
TRUST_PROXY=0
COOKIE_SECURE=0

# Optional deployment identity (Render supplies RENDER_GIT_COMMIT automatically):
SAFETAP_COMMIT=

# School sign-in: admin maps school email to an existing account first.
SCHOOL_EMAIL_DOMAIN=g.batstate-u.edu.ph
# Enable email OTP and password recovery with a verified Resend sender:
RESEND_API_KEY=
EMAIL_FROM=
# Enable Google sign-in after creating a Web OAuth client:
PUBLIC_APP_URL=https://spartap.terincorp.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
